(rule "Nano_GND_J3_7 finite return" (layer outer) (condition "((A.hasNetclass('HS100_MIPI') || A.hasNetclass('HS90_USB2') || A.hasNetclass('HS90_USB3')) && A.Type == 'Track' && B.NetName == 'GND' && (B.Type == 'Track' || B.Type == 'Via') && B.enclosedByArea('Nano_GND_J3_7')) || ((B.hasNetclass('HS100_MIPI') || B.hasNetclass('HS90_USB2') || B.hasNetclass('HS90_USB3')) && B.Type == 'Track' && A.NetName == 'GND' && (A.Type == 'Track' || A.Type == 'Via') && A.enclosedByArea('Nano_GND_J3_7'))") (constraint clearance (min 0.15mm)))
(rule "Connector escape CM1" (condition "(A.hasNetclass('LS') || A.hasNetclass('PWR_AUX')) && A.intersectsCourtyard('CM1')") (constraint clearance (min 0.125mm)))
(rule "Connector escape CM2" (condition "(A.hasNetclass('LS') || A.hasNetclass('PWR_AUX')) && A.intersectsCourtyard('CM2')") (constraint clearance (min 0.125mm)))
(rule "LS CM ground stub CM1" (condition "A.Type == 'Track' && A.NetName == 'GND' && A.intersectsCourtyard('CM1') && B.Type == 'Track' && (B.hasNetclass('HS100_MIPI') || B.hasNetclass('HS90_USB2') || B.hasNetclass('HS90_USB3'))") (constraint clearance (min 0.15mm)))
(rule "LS CM ground via CM1" (condition "A.Type == 'Via' && A.NetName == 'GND' && A.intersectsCourtyard('CM1')") (constraint via_diameter (min 0.25mm)) (constraint hole_size (min 0.15mm)) (constraint annular_width (min 0.05mm)))
(rule "LS CM ground stub CM2" (condition "A.Type == 'Track' && A.NetName == 'GND' && A.intersectsCourtyard('CM2') && B.Type == 'Track' && (B.hasNetclass('HS100_MIPI') || B.hasNetclass('HS90_USB2') || B.hasNetclass('HS90_USB3'))") (constraint clearance (min 0.15mm)))
(rule "LS CM ground via CM2" (condition "A.Type == 'Via' && A.NetName == 'GND' && A.intersectsCourtyard('CM2')") (constraint via_diameter (min 0.25mm)) (constraint hole_size (min 0.15mm)) (constraint annular_width (min 0.05mm)))
(rule "CM1 escape via" (condition "A.Type == 'Via' && (A.hasNetclass('LS') || A.hasNetclass('PWR_AUX')) && A.intersectsCourtyard('CM1')") (constraint via_diameter (min 0.35mm)) (constraint annular_width (min 0.075mm)))
(rule "CM1 escape hole clearance" (condition "A.Type == 'Via' && A.intersectsCourtyard('CM1') && B.intersectsCourtyard('CM1')") (constraint hole_clearance (min 0.2mm)))
(rule "CM1 pad via" (condition "A.Type == 'Via' && A.enclosedByArea('CM1_socket')") (constraint via_diameter (min 0.25mm)) (constraint hole_size (min 0.15mm)) (constraint annular_width (min 0.05mm)))
(rule "CM1 pad via on the courtyard line" (condition "A.Type == 'Via' && (A.NetName == '/SD_CMD' || A.NetName == '/PWR_BUTTON' || A.NetName == '/PI_PWR_LED') && A.intersectsCourtyard('CM1')") (constraint via_diameter (min 0.25mm)) (constraint hole_size (min 0.15mm)) (constraint annular_width (min 0.05mm)))
(rule "U7 ground stub" (condition "A.Type == 'Track' && A.NetName == 'GND' && A.intersectsCourtyard('U7') && B.Type == 'Track' && (B.hasNetclass('HS100_MIPI') || B.hasNetclass('HS90_USB2') || B.hasNetclass('HS90_USB3'))") (constraint clearance (min 0.15mm)))
(rule "PI1 ground via" (condition "A.Type == 'Via' && A.NetName == 'GND' && A.intersectsCourtyard('PI1')") (constraint via_diameter (min 0.25mm)) (constraint hole_size (min 0.15mm)) (constraint annular_width (min 0.05mm)))
(rule "PI1 ground via hole clearance" (condition "A.Type == 'Via' && A.NetName == 'GND' && A.intersectsCourtyard('PI1')") (constraint hole_clearance (min 0.2mm)))
(rule "In1 plane to board edge" (layer "In1.Cu") (condition "A.Type == 'Zone'") (constraint edge_clearance (min 0.27mm)))
(rule "In6 plane to board edge" (layer "In6.Cu") (condition "A.Type == 'Zone'") (constraint edge_clearance (min 0.27mm)))
