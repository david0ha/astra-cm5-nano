(version 1)
# Candidate; native syntax and DRC verification required. One complete rule per line.
(rule "Ordinary copper" (constraint clearance (min 0.15mm)))
(rule "Ordinary holes" (constraint hole_clearance (min 0.25mm)))
(rule "Ordinary via" (condition "A.Type == 'Via'") (constraint via_diameter (min 0.40mm)) (constraint hole_size (min 0.20mm)) (constraint annular_width (min 0.10mm)))
(rule "NPTH drill minimum" (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'") (constraint hole_size (min 0.50mm)))
(rule "PTH annular minimum" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint annular_width (min 0.15mm)))
(rule "PTH outer hole clearance" (layer outer) (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.28mm)))
(rule "PTH inner hole clearance" (layer inner) (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.30mm)))
(rule "Keep internal layers ground only" (layer inner) (condition "A.NetName != 'GND' && !A.hasNetclass('LS') && !A.hasNetclass('PWR_AUX')") (constraint disallow track zone))
(rule "In1 ground plane only" (layer "In1.Cu") (condition "A.NetName != 'GND'") (constraint disallow track zone))
(rule "In6 ground plane only" (layer "In6.Cu") (condition "A.NetName != 'GND'") (constraint disallow track zone))
(rule "HS trunk isolation" (condition "(A.hasNetclass('HS100_MIPI') || A.hasNetclass('HS90_USB2') || A.hasNetclass('HS90_USB3')) && A.Type == 'Track' && !AB.isCoupledDiffPair()") (constraint clearance (min 0.50mm)))
(rule "Low-speed via to HS track" (condition "A.Type == 'Via' && (A.hasNetclass('LS') || A.hasNetclass('PWR_AUX') || A.NetName == 'GND') && B.Type == 'Track' && (B.hasNetclass('HS100_MIPI') || B.hasNetclass('HS90_USB2') || B.hasNetclass('HS90_USB3'))") (constraint clearance (min 0.2mm)))
(rule "HS90_geometry" (layer outer) (condition "(A.hasNetclass('HS90_USB2') || A.hasNetclass('HS90_USB3'))") (constraint track_width (min 0.1573mm) (opt 0.1573mm) (max 0.1573mm)) (constraint diff_pair_gap (min 0.2000mm) (opt 0.2000mm) (max 0.2000mm)))
(rule "HS100_geometry" (layer outer) (condition "(A.hasNetclass('HS100_MIPI'))") (constraint track_width (min 0.1235mm) (opt 0.1235mm) (max 0.1235mm)) (constraint diff_pair_gap (min 0.2000mm) (opt 0.2000mm) (max 0.2000mm)))
(rule "Independent pair skew 0.15" (condition "(A.hasNetclass('HS100_MIPI') || A.hasNetclass('HS90_USB2'))") (constraint skew (max 0.15mm) (within_diff_pairs)))
(rule "Independent pair skew 0.1" (condition "(A.hasNetclass('HS90_USB3'))") (constraint skew (max 0.1mm) (within_diff_pairs)))
(rule "Nano TX segment skew budget" (condition "A.inDiffPair('/USB3-0-TX*')") (constraint skew (max 0.05mm) (within_diff_pairs)))
(rule "Reviewed own pads" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent && (A.Reference == 'C21' || A.Reference == 'C22' || A.Reference == 'CM2' || A.Reference == 'J1' || A.Reference == 'J2' || A.Reference == 'J3' || A.Reference == 'Type_C1' || A.Reference == 'U10' || A.Reference == 'U14' || A.Reference == 'U16' || A.Reference == 'U2' || A.Reference == 'U5' || A.Reference == 'U6' || A.Reference == 'U7' || A.Reference == 'U8' || A.Reference == 'U9')") (constraint clearance (min 0.15mm)))
(rule "C21 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('C21') && B.Type == 'Pad' && B.memberOfFootprint('C21')") (constraint clearance (min 0.15mm)))
(rule "C22 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('C22') && B.Type == 'Pad' && B.memberOfFootprint('C22')") (constraint clearance (min 0.15mm)))
(rule "CM2 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('CM2') && B.Type == 'Pad' && B.memberOfFootprint('CM2')") (constraint clearance (min 0.15mm)))
(rule "J1 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('J1') && B.Type == 'Pad' && B.memberOfFootprint('J1')") (constraint clearance (min 0.15mm)))
(rule "J2 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('J2') && B.Type == 'Pad' && B.memberOfFootprint('J2')") (constraint clearance (min 0.15mm)))
(rule "J3 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('J3') && B.Type == 'Pad' && B.memberOfFootprint('J3')") (constraint clearance (min 0.15mm)))
(rule "Type_C1 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('Type_C1') && B.Type == 'Pad' && B.memberOfFootprint('Type_C1')") (constraint clearance (min 0.15mm)))
(rule "U10 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('U10') && B.Type == 'Pad' && B.memberOfFootprint('U10')") (constraint clearance (min 0.15mm)))
(rule "U14 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('U14') && B.Type == 'Pad' && B.memberOfFootprint('U14')") (constraint clearance (min 0.15mm)))
(rule "U16 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('U16') && B.Type == 'Pad' && B.memberOfFootprint('U16')") (constraint clearance (min 0.15mm)))
(rule "U2 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('U2') && B.Type == 'Pad' && B.memberOfFootprint('U2')") (constraint clearance (min 0.15mm)))
(rule "U5 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('U5') && B.Type == 'Pad' && B.memberOfFootprint('U5')") (constraint clearance (min 0.15mm)))
(rule "U6 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('U6') && B.Type == 'Pad' && B.memberOfFootprint('U6')") (constraint clearance (min 0.15mm)))
(rule "U7 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('U7') && B.Type == 'Pad' && B.memberOfFootprint('U7')") (constraint clearance (min 0.15mm)))
(rule "U8 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('U8') && B.Type == 'Pad' && B.memberOfFootprint('U8')") (constraint clearance (min 0.15mm)))
(rule "U9 direct fanout" (condition "A.Type == 'Track' && A.intersectsCourtyard('U9') && B.Type == 'Pad' && B.memberOfFootprint('U9')") (constraint clearance (min 0.15mm)))
(rule "GCT locator ground clearance" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent && A.Reference == 'Type_C1' && A.Pad_Type == 'NPTH, mechanical' && (B.Pad_Number == 'A1' || B.Pad_Number == 'B12' || B.Pad_Number == 'A12' || B.Pad_Number == 'B1')") (constraint hole_clearance (min 0.20mm)))

(rule "Nano_GND_U10_8 finite return" (layer outer) (condition "((A.hasNetclass('HS100_MIPI') || A.hasNetclass('HS90_USB2') || A.hasNetclass('HS90_USB3')) && A.Type == 'Track' && B.NetName == 'GND' && (B.Type == 'Track' || B.Type == 'Via') && B.enclosedByArea('Nano_GND_U10_8')) || ((B.hasNetclass('HS100_MIPI') || B.hasNetclass('HS90_USB2') || B.hasNetclass('HS90_USB3')) && B.Type == 'Track' && A.NetName == 'GND' && (A.Type == 'Track' || A.Type == 'Via') && A.enclosedByArea('Nano_GND_U10_8'))") (constraint clearance (min 0.15mm)))

