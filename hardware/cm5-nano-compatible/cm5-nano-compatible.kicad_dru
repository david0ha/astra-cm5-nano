(rule "Nano_GND_J3_10 finite return" (layer outer) (condition "((A.hasNetclass('HS100_MIPI') || A.hasNetclass('HS90_USB2') || A.hasNetclass('HS90_USB3')) && A.Type == 'Track' && B.NetName == 'GND' && (B.Type == 'Track' || B.Type == 'Via') && B.enclosedByArea('Nano_GND_J3_10')) || ((B.hasNetclass('HS100_MIPI') || B.hasNetclass('HS90_USB2') || B.hasNetclass('HS90_USB3')) && B.Type == 'Track' && A.NetName == 'GND' && (A.Type == 'Track' || A.Type == 'Via') && A.enclosedByArea('Nano_GND_J3_10'))") (constraint clearance (min 0.15mm)))

